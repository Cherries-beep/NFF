# Файл окружения, в котором хранятся приватные настройки, переменные

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres_notes # имя контейнера в docker compose
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/postgres_notes # урл для приложения и алембика