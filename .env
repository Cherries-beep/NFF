""" Файл окружения, в котором хранятся приватные настройки, переменные """

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres_notes
POSTGRES_HOST=db # имя контейнера PostgreSQL в docker compose
POSTGRES_PORT=5432

DATABASE_URL=(
postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
)